# MongoDB connection string
MONGO_URI=

# WhatsApp number that receives orders: country code + number, digits only (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Razorpay checkout is disabled while orders go through WhatsApp. Set to true to re-enable.
NEXT_PUBLIC_CHECKOUT_ENABLED=false

# Razorpay (only used when checkout is enabled)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
